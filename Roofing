<script>
(function() {
  'use strict';

  /* ---------- PAGE ROUTING ---------- */
  const pages = document.querySelectorAll('.page');
  const pageLinks = document.querySelectorAll('[data-page-link]');
  const navLinks = document.querySelectorAll('.nav-links a');

  function showPage(pageId) {
    const target = document.getElementById('page-' + pageId);
    if (!target) return;
    pages.forEach(p => p.classList.remove('active'));
    target.classList.add('active');
    navLinks.forEach(a => {
      a.classList.toggle('active', a.getAttribute('data-page-link') === pageId);
    });
    // Close mobile nav
    document.getElementById('navLinks').classList.remove('open');
    document.getElementById('mobileToggle').setAttribute('aria-expanded', 'false');
    // Scroll to top
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function handleHash() {
    const hash = window.location.hash.replace('#', '') || 'home';
    showPage(hash);
  }

  pageLinks.forEach(link => {
    link.addEventListener('click', function(e) {
      const pageId = this.getAttribute('data-page-link');
      if (!pageId) return;
      e.preventDefault();
      window.location.hash = pageId;
      showPage(pageId);
    });
  });

  window.addEventListener('hashchange', handleHash);

  /* ---------- MOBILE NAV ---------- */
  const mobileToggle = document.getElementById('mobileToggle');
  const navLinksEl = document.getElementById('navLinks');
  mobileToggle.addEventListener('click', function() {
    const isOpen = navLinksEl.classList.toggle('open');
    this.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  /* ---------- FAQ ACCORDION ---------- */
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', function() {
      const item = this.parentElement;
      const isOpen = item.classList.contains('open');
      // Close others
      document.querySelectorAll('.faq-item.open').forEach(i => {
        i.classList.remove('open');
        i.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('open');
        this.setAttribute('aria-expanded', 'true');
      }
    });
  });

  /* ---------- FORM VALIDATION & SPAM PROTECTION ---------- */
  const form = document.getElementById('estimateForm');
  const formStatus = document.getElementById('formStatus');
  const integrationNote = document.getElementById('integrationNote');
  const timestampField = document.getElementById('formTimestamp');

  // Set timestamp on page load
  if (timestampField) timestampField.value = Date.now();

  function setError(group, message) {
    group.classList.add('invalid');
    const msg = group.querySelector('.error-msg');
    if (msg) msg.textContent = message;
  }

  function clearError(group) {
    group.classList.remove('invalid');
  }

  function validateForm() {
    let valid = true;
    const groups = form.querySelectorAll('.form-group');

    groups.forEach(group => {
      const input = group.querySelector('input, select, textarea');
      if (!input) return;
      clearError(group);

      if (input.hasAttribute('required') && !input.value.trim()) {
        setError(group, 'This field is required.');
        valid = false;
        return;
      }

      if (input.type === 'email' && input.value.trim()) {
        const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRe.test(input.value.trim())) {
          setError(group, 'Please enter a valid email address.');
          valid = false;
        }
      }

      if (input.id === 'phone' && input.value.trim()) {
        const digits = input.value.replace(/\D/g, '');
        if (digits.length < 10) {
          setError(group, 'Please enter a phone number with at least 10 digits.');
          valid = false;
        }
      }

      if (input.id === 'zip' && input.value.trim()) {
        if (!/^\d{5}$/.test(input.value.trim())) {
          setError(group, 'Please enter a 5-digit ZIP code.');
          valid = false;
        }
      }

      if (input.id === 'description' && input.value.trim() && input.value.trim().length < 10) {
        setError(group, 'Please provide at least 10 characters.');
        valid = false;
      }
    });

    return valid;
  }

  form.addEventListener('submit', function(e) {
    e.preventDefault();

    // Honeypot check
    const honeypot = document.getElementById('website');
    if (honeypot && honeypot.value.trim() !== '') {
      // Silent fail for bots
      formStatus.className = 'form-status error';
      formStatus.textContent = 'Submission blocked.';
      formStatus.style.display = 'block';
      return;
    }

    // Time-based spam check (minimum 3 seconds to fill)
    const timestamp = parseInt(timestampField.value, 10);
    if (timestamp && Date.now() - timestamp < 3000) {
      formStatus.className = 'form-status error';
      formStatus.textContent = 'Please take a moment to review your information before submitting.';
      formStatus.style.display = 'block';
      return;
    }

    if (!validateForm()) {
      formStatus.className = 'form-status error';
      formStatus.textContent = 'Please correct the highlighted fields and try again.';
      formStatus.style.display = 'block';
      const firstInvalid = form.querySelector('.form-group.invalid input, .form-group.invalid select, .form-group.invalid textarea');
      if (firstInvalid) firstInvalid.focus();
      return;
    }

    // NO BACKEND CONNECTED — do not fake success.
    formStatus.className = 'form-status error';
    formStatus.innerHTML = '<strong><i class="fas fa-triangle-exclamation"></i> Form not yet connected.</strong> Your information passed local validation, but this website does not have a live email/CRM endpoint. No submission was sent. Connect a form handler before collecting leads.';
    formStatus.style.display = 'block';
    integrationNote.style.display = 'block';
    formStatus.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  /* ---------- FOOTER YEAR ---------- */
  document.getElementById('year').textContent = new Date().getFullYear();

  /* ---------- PHONE PLACEHOLDER SAFETY ---------- */
  // Prevent tel: links from dialing literal placeholder text
  document.querySelectorAll('[data-phone-link]').forEach(link => {
    link.addEventListener('click', function(e) {
      const href = this.getAttribute('href');
      if (href && href.includes('[BUSINESS PHONE]')) {
        e.preventDefault();
        alert('Phone number placeholder. Replace [BUSINESS PHONE] with the real business number before launch.');
      }
    });
  });

  /* ---------- INITIAL PAGE ---------- */
  handleHash();

})();
</script>
